# .env.example - Template for environment variables
# Copy to .env for local dev. NEVER commit .env (git-ignored).
# NOTE: every VITE_* var is baked into the browser bundle at BUILD time —
# public values only, never secrets.

# Public config (safe to expose in the browser bundle)
VITE_APP_NAME=SATMAT
VITE_WHATSAPP_NUMBER=919876543210
VITE_SUPPORT_EMAIL=support@satmat.example

# Backend API base URL (build-time). Defaults to the live backend the webapp uses.
# For local dev against a local backend, override in .env: VITE_API_BASE_URL=http://localhost:8080/api/v1
# Production (Vercel): leave unset or set to https://satmat-backendfinal.onrender.com — the build
# will use same-origin /api/v1 via vercel.json rewrites when VITE_API_BASE_URL is empty or localhost.
# Vercel Project Settings > Environment Variables (all environments):
#   VITE_API_BASE_URL=https://satmat-backendfinal.onrender.com
VITE_API_BASE_URL=https://satmat-backendfinal.onrender.com/api/v1

# Webapp URL — every "Play Now / Sign In / Create Account" CTA points here.
# Vercel: set to the deployed webapp URL (the `web/` project).
#   VITE_WEBAPP_URL=https://<webapp>.vercel.app
VITE_WEBAPP_URL=http://localhost:3000
